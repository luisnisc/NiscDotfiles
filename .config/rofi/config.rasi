configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               " ";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10";
}

@import "colors.rasi"

* {
    background-color: transparent;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      600px;
    enabled:                    true;
    border:                     2px solid;
    border-radius:              16px;
    border-color:               @border-color;
    background-color:           @background;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    15px;
    padding:                    20px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    12px 16px;
    border-radius:              10px;
    background-color:           @background-alt;
    text-color:                 @foreground;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    text-color:                 @selected;
}

entry {
    enabled:                    true;
    text-color:                 @foreground;
    cursor:                     text;
    placeholder:                "Buscar aplicaciones...";
    placeholder-color:          @foreground-dim;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    spacing:                    6px;
    background-color:           transparent;
}

/* --- ELEMENTOS DE LA LISTA --- */

element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    10px 14px;
    border-radius:              10px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     pointer;
}

/* Normal deseleccionado */
element normal.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}

/* Alterno deseleccionado (Evita los parches beige) */
element alternate.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}

/* Seleccionado */
element selected.normal {
    background-color:           @selected;
    text-color:                 @selected-text;
}

element-icon {
    size:                       24px;
    cursor:                     inherit;
}

element-text {
    text-color:                 inherit;
    vertical-align:             0.5;
}
