* {
    background: #{{colors.surface.default.hex_stripped}}E6;
    background-alt: #{{colors.surface_container_high.default.hex_stripped}}FF;
    foreground: #{{colors.on_surface.default.hex_stripped}}FF;
    foreground-dim: #{{colors.on_surface_variant.default.hex_stripped}}FF;
    selected: #{{colors.primary.default.hex_stripped}}FF;
    selected-text: #{{colors.on_primary.default.hex_stripped}}FF;
    border-color: #{{colors.outline.default.hex_stripped}}40;
}
